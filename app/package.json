{
  "name": "app",
  "version": "0.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.1.0",
    "expo-status-bar": "~58.0.5",
    "planck": "^1.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "use-effect-reducer": "^0.8.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@red_dial/rn-tooling-config": "^0.2.0-alpha.2",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.3.3",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.16",
    "prettier": "^3.10.1",
    "rnsec": "1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "setup-skia-web public && expo start --web",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "sim": "npx tsx scripts/sim.ts",
    "security": "node scripts/security.mjs",
    "security:baseline": "node scripts/security.mjs --update",
    "prepare": "cd .. && husky app/.husky",
    "commitlint": "commitlint"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts"
    ]
  }
}
